# Gemini Agent
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL_ID=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL_ID=gemini-3-flash-preview
AGENT_RESPONSE_TIMEOUT_SECONDS=60

# PostgreSQL. Keep the password in DATABASE_URL synchronized.
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=motor_monitor_db
DATABASE_URL=postgresql://agent_user:replace_with_a_strong_password@db:5432/motor_monitor_db

# Application
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173
INFERENCE_OUTPUT_DIR=/app/outputs
REPORT_TIMEZONE_OFFSET_HOURS=8
ANOMALY_TEMPERATURE_THRESHOLD=35.0

# Host ports used by docker-compose.prod.yml
APP_PORT=5173
BACKEND_PORT=8000
