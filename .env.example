# Copy this file to .env and replace every CHANGE_ME value.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL_ID=gemini-3.5-flash-lite

POSTGRES_USER=agent_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=motor_monitor_db
DATABASE_URL=postgresql://agent_user:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@db:5432/motor_monitor_db

# Full six-model CPU research environment is the deployment default.
BACKEND_REQUIREMENTS_FILE=requirements-research.txt
# Demo/workbench deployment: true refreshes the versioned 7-day fixtures.
# Set false when connecting a production instance to audited real data.
SEED_DEMO_DATA=true
INFERENCE_OUTPUT_DIR=/app/outputs
REPORT_TIMEZONE_OFFSET_HOURS=8
ANOMALY_TEMPERATURE_THRESHOLD=35.0
AGENT_RESPONSE_TIMEOUT_SECONDS=60

# Use the actual HTTPS frontend origin for public deployments.
CORS_ORIGINS=http://localhost:5173
WEB_PORT=5173
BACKEND_PORT=8000
